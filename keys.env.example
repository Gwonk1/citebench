# copy to keys.env (gitignored) and fill in; KEY=value, no quotes needed
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# org-scoped Anthropic keys need the workspace id (sent as the anthropic-workspace-id header)
ANTHROPIC_WORKSPACE_ID=
GEMINI_API_KEY=
# Syfert MCP bearer token (owner token lives in /etc/syfert-mcp.conf on xeric)
SYFERT_MCP_TOKEN=
# OpenAI-compatible llama.cpp endpoint on this box
LOCAL_OPENAI_BASE=http://127.0.0.1:8080/v1
